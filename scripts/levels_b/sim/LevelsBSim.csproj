<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless copy of the Unity bot (Editor/LevelsBDifficultyChecks.cs) on the game's own battle model.
       The model sources are compiled straight from UnityProject; only the Unity-bound pieces are replaced here. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS0414;CS0649;CS0169;CS0162;CS0219;CS8632</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Game>../../../UnityProject/Assets/Flightbeat</Game>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(Game)/Model/*.cs" Exclude="$(Game)/Model/PressureSettings.cs" />
    <Compile Include="$(Game)/Economy/FleetLoadout.cs;$(Game)/Economy/LegendaryKind.cs;$(Game)/Economy/FleetCatalog.Pure.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>
</Project>
